{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pragmaticfox-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "pragmaticfox.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pragmaticfox.com",
      "custom_domain": true
    }
  ]
}
